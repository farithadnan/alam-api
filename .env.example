PORT=8080
DB_PATH=data/udara.db
LOG_LEVEL=info
# Where alert links in Telegram point (a live site/tunnel; ohmyalam.com is the placeholder)
SITE_URL=https://ohmyalam.com
# Telegram alerts are silent overnight (Malaysia time, inclusive start, exclusive end)
ALERT_QUIET_START=23
ALERT_QUIET_END=7
# DOE APIMS states to poll — empty = all 16 states; or comma-separated ids e.g. 1,10,14
EQMS_STATES=
# Polling interval (seconds) shared by adapters
POLL_SECONDS=300
POLL_NEWS_SECONDS=1800
# newsdata.io API key (optional; without it news falls back to free Malaysian RSS)
NEWSDATA_API_KEY=
