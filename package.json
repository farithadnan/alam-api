{
  "name": "alam-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "description": "Air-quality & environmental hazards ingest + read API for Malaysia (Johor first). Sources: DOE eqms, Open-Meteo, USGS, NOAA ONI.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "ingest": "tsx src/cli.ts",
    "backfill": "tsx src/cli.ts backfill",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:drift": "tsx scripts/check-drift.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
